{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cofide Cloud Observer values",
  "type": "object",
  "properties": {
    "cofideCloudObserver": {
      "type": "object",
      "description": "Configuration settings for the Cloud Observer.",
      "additionalProperties": false,
      "properties": {
        "connectAPI": {
          "type": "object",
          "description": "Configuration for connecting to the Connect API.",
          "additionalProperties": false,
          "properties": {
            "grpcTarget": {
              "type": "string",
              "description": "gRPC target for the Connect API's mTLS endpoint.",
              "minLength": 1
            },
            "serverNameOverride": {
              "type": "string",
              "description": "Optional server name (SNI) used by Envoy to select the filter chain. Not used for verification."
            },
            "spiffeID": {
              "type": "string",
              "description": "SPIFFE ID of the Connect API.",
              "pattern": "^spiffe://.+"
            },
            "configSyncInterval": {
              "type": "string",
              "description": "Interval between config syncs as a Go duration string. Must be greater than 0.",
              "minLength": 1
            }
          },
          "required": [
            "grpcTarget",
            "spiffeID",
            "configSyncInterval"
          ]
        },
        "defaultSTSRegion": {
          "type": "string",
          "description": "Default AWS STS region. Omit to use the application default."
        },
        "leaderElection": {
          "type": "object",
          "description": "Leader election configuration.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "leaseName": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "description": "Namespace of the Lease. Defaults to the release namespace."
            },
            "leaseDuration": {
              "type": "string",
              "description": "Go duration string."
            },
            "renewDeadline": {
              "type": "string",
              "description": "Go duration string."
            },
            "retryPeriod": {
              "type": "string",
              "description": "Go duration string."
            }
          }
        },
        "health": {
          "type": "object",
          "description": "HTTP server for the liveness and readiness endpoints.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      },
      "required": [
        "connectAPI"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "spiffeWorkloadApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volume": {
          "type": "object",
          "description": "Volume source for the SPIFFE Workload API socket."
        },
        "mountPath": {
          "type": "string",
          "minLength": 1,
          "description": "Where the volume is mounted in the container. Must contain socketPath."
        },
        "socketPath": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the Workload API socket within the container."
        }
      }
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
